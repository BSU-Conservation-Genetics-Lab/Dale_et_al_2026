#!/bin/bash
# Extract the CDS region from TLR1A from whole genome haplotype 

# NEGATIVE STRAND

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Hu-Liu_GYRF/Haplotype_072426/CDS/2_Phased_VCF_Genomes

for genome in *_TLR1B_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR1B from $sample"

    {
        echo ">${sample}_TLR1B"

        samtools faidx "$genome" \
            NC_051187.1:99999964-100001649 \
        | awk '!/^>/'

   } | seqtk seq -r - > "${sample}_CDS.fa"

done
