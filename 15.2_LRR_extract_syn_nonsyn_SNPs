# !/bin/bash
# Extract synonymous and nonsynonymous SNPs for each sample
# LRR

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Hu-Liu_GYRF/LRR/Annotated_VCFs

output_csv="Individual_Syn_Missense_Count_LRR.csv"
echo "VCF_File,Sample,Missense_Count,Synonymous_Count" > "$output_csv"

for vcf in *.vcf; do
  echo "Processing $vcf..."

  # Get sample names in order
  mapfile -t samples < <(bcftools query -l "$vcf")
  sample_line=$(IFS=' '; echo "${samples[*]}")

  bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\t%INFO/ANN[\t%GT]\n' "$vcf" | \
  awk -v samples="$sample_line" -v out="$output_csv" -v filename="$vcf" '
  BEGIN {
    FS="\t";
    split(samples, sample_names, " ");
    for (i in sample_names) {
      missense_count[sample_names[i]] = 0;
      synonymous_count[sample_names[i]] = 0;
    }
  }
  {
    ann_field = $5;
    split(ann_field, annotations, ",");
    missense = 0;
    synonymous = 0;

    for (a in annotations) {
      split(annotations[a], ann_parts, "|");
      effect = ann_parts[2];
      if (effect == "missense_variant") missense = 1;
      else if (effect == "synonymous_variant") synonymous = 1;
    }

    if (missense == 1 || synonymous == 1) {
      for (i = 6; i <= NF; i++) {
        gt = $i;
        if (gt != "0/0" && gt != "0|0" && gt != "./." && gt != "." && gt != ".|.") {
          sample = sample_names[i - 5];
          if (missense == 1) missense_count[sample]++;
          if (synonymous == 1) synonymous_count[sample]++;
        }
      }
    }
  }
  END {
    for (s in sample_names) {
      sample = sample_names[s];
      print filename "," sample "," missense_count[sample] "," synonymous_count[sample] >> out;
    }
  }
  '
done

echo "Done. Counts saved in $output_csv"
