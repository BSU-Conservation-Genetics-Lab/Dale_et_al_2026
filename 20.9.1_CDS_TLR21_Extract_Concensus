cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Hu-Liu_GYRF/Haplotype_072426/CDS/2_Phased_VCF_Genomes

for genome in *_TLR21_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR21 from $sample"

    {
        echo ">${sample}_TLR21"

        samtools faidx "$genome" \
            NC_051189.1:103570191-103573229 \
        | awk '!/^>/'

   } | seqtk seq -r - >"${sample}_CDS.fa"

done
