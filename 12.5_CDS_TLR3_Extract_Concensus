#!/bin/bash
# Extract the CDS region from TLR3 from whole genome haplotype 

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Cali_Per_Hart_PEFA/DNAsp_CPH_28/CDS/2_Phased_VCF_Genomes

for genome in *_TLR3_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR3 from $sample"

    {
        echo ">${sample}_TLR3"

        samtools faidx "$genome" \
           NC_073722.1:19430736-19430964 \
           NC_073722.1:19431625-19433450 \
           NC_073722.1:19435064-19435255 \
           NC_073722.1:19436668-19437111 \
        | awk '!/^>/'

   } | seqtk seq -r - > "${sample}_CDS.fa"

done
