#!/bin/bash
# Extract the CDS region from TLR15 from whole genome haplotype 

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Cali_Per_Hart_PEFA/DNAsp_CPH_28/CDS/2_Phased_VCF_Genomes

for genome in *_TLR15_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR15 from $sample"

    {
        echo ">${sample}_TLR15"

        samtools faidx "$genome" \
           NC_073731.1:1547929-1550547 \
        | awk '!/^>/'

   }  > "${sample}_CDS.fa"

done
