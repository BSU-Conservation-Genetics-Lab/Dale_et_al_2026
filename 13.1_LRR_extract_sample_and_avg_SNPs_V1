# !/bin/bash
# Calculate SNPs for each sample and calculate the average number of SNPs by gene
# Version 1
# LRR

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Hu-Liu_GYRF/LRR

individual_csv="LRR_individual_snp_counts_051626.csv"
average_csv="LRR_average_snp_counts_051626.csv"

echo "File,Sample,SNP_Count" > "$individual_csv"
echo "File,Average_SNPs_Per_Genome" > "$average_csv"

for vcf in *.vcf.gz; do

    echo "Processing $vcf"

    base=$(basename "$vcf" .vcf.gz)

    mapfile -t samples < <(bcftools query -l "$vcf")

    sample_string=$(IFS=" "; echo "${samples[*]}")

    # Extract biallelic SNP genotypes
    bcftools view -v snps -m2 -M2 "$vcf" | \
    bcftools query -f '%CHROM\t%POS[\t%GT]\n' | \
    awk \
        -v file="$base" \
        -v indiv="$individual_csv" \
        -v avgout="$average_csv" \
        -v sample_string="$sample_string" '

    BEGIN {
        split(sample_string, samples, " ")
        nsamples = length(samples)

        for (i = 1; i <= nsamples; i++) {
            count[samples[i]] = 0
        }
    }

    {
        for (i = 1; i <= nsamples; i++) {

            gt = $(i + 2)

            # Count non-reference, non-missing genotypes
            if (gt !~ /^0[\/|]0$/ && gt !~ /^\./) {
                count[samples[i]]++
            }
        }
    }

    END {

        total = 0

        for (i = 1; i <= nsamples; i++) {

            sample = samples[i]

            print file "," sample "," count[sample] >> indiv

            total += count[sample]
        }

        avg = (nsamples > 0) ? total / nsamples : 0

        print file "," avg >> avgout
    }'

done
