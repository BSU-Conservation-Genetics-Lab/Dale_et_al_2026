#!/bin/bash
# Extract the LRR region from TLR5 whole genome haplotype 

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Hu-Liu_GYRF/Haplotype_072426/LRR/2_Phased_VCF_Genomes

for genome in *_TLR5_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR5 from $sample"

    {
        echo ">${sample}_TLR5"

        samtools faidx "$genome" \
            NC_051198.1:26665564-26665629 \
            NC_051198.1:26665414-26665479 \
            NC_051198.1:26665339-26665404 \
            NC_051198.1:26664985-26665050 \
            NC_051198.1:26664913-26664978 \
            NC_051198.1:26664841-26664906 \
            NC_051198.1:26664769-26664834 \
            NC_051198.1:26664697-26664762 \
            NC_051198.1:26664580-26664645 \
            NC_051198.1:26664343-26664408 \
            NC_051198.1:26664271-26664336 \
            NC_051198.1:26664205-26664270 \
        | awk '!/^>/'

    } | seqtk seq -r - > "${sample}_LRR.fa"

done
