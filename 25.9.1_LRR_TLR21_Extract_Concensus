#!/bin/bash
# Extract the LRR region from TLR21 whole genome haplotype 

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Hu-Liu_GYRF/Haplotype_072426/LRR/2_Phased_VCF_Genomes

for genome in *_TLR21_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR21 from $sample"

    {
        echo ">${sample}_TLR21"

        samtools faidx "$genome" \
            NC_051189.1:103572816-103572881 \
            NC_051189.1:103572744-103572809 \
            NC_051189.1:103572672-103572737 \
            NC_051189.1:103572600-103572665 \
            NC_051189.1:103572450-103572515 \
            NC_051189.1:103572309-103572374 \
            NC_051189.1:103572237-103572302 \
            NC_051189.1:103572015-103572080 \
            NC_051189.1:103571856-103571921 \
            NC_051189.1:103571712-103571777 \
            NC_051189.1:103571640-103571705 \
            NC_051189.1:103571568-103571633 \
            NC_051189.1:103571496-103571561 \
            NC_051189.1:103571421-103571486 \
            NC_051189.1:103571253-103571318 \
            NC_051189.1:103571097-103571168 \
            NC_051189.1:103571028-103571096 \
        | awk '!/^>/'

   } | seqtk seq -r - > "${sample}_LRR.fa"

done
