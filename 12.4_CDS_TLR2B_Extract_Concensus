#!/bin/bash
# Extract the CDS region from TLR2B from whole genome haplotype 

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Cali_Per_Hart_PEFA/DNAsp_CPH_28/CDS/2_Phased_VCF_Genomes

for genome in *_TLR2B_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR2B from $sample"

    {
        echo ">${sample}_TLR2B"

        samtools faidx "$genome" \
           NC_073722.1:77671031-77673382 \
        | awk '!/^>/'

   } > "${sample}_CDS.fa"

done
