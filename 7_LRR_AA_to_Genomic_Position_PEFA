#################
# PEFA TLR1A ------------------------------------------------
#################

# Single Exon
#--------------------------
gene_id <- "LOC101914363"

txs <- transcriptsBy(txdb, by = "gene")[[gene_id]]

if (is.null(txs) || length(txs) == 0) {
  stop("Gene not found in annotation.")
}

tx_id <- "XM_005243208.4"

#--------------------------
# 5. Function: AA → Genome
#--------------------------
map_aa_to_genome <- function(txdb, tx_id, aa_df) {
  
  # Validate input
  stopifnot(all(c("start", "end") %in% colnames(aa_df)))
  
  cds <- cdsBy(txdb, by = "tx", use.names = TRUE)[[tx_id]]
  
  if (is.null(cds)) {
    stop("Transcript not found or has no CDS.")
  }
  
  # AA → nucleotide (CDS-relative)
  nt_ranges <- IRanges(
    start = (aa_df$start - 1) * 3 + 1,
    end   = aa_df$end * 3
  )
  
  # Map to genome
  gr <- pmapFromTranscripts(nt_ranges, cds)
  
  # Optional: attach AA info
  mcols(gr)$aa_start <- aa_df$start
  mcols(gr)$aa_end   <- aa_df$end
  
  return(gr)
}

#--------------------------
# 6. AA Regions
#--------------------------
aa_ranges <- data.frame(
  start = c(49, 73, 97, 118, 361, 385, 411, 436, 458, 481), 
  end = c(70, 94, 117, 139, 381, 406, 432, 456, 480, 502)
  )

#--------------------------
# 7. Run
#--------------------------
TLR1A_coords <- map_aa_to_genome(txdb, tx_id, aa_ranges)

TLR1A_coords 

#--------------------------
# 12. Save Outputs
#--------------------------
# Save as R object
#saveRDS(TLR1A_coords, file = "PEFA_TLR1A_genomic_coords.rds")

# Save as CSV
df <- as.data.frame(TLR1A_coords)
write.csv(df, file = "PEFA_TLR1A_genomic_coords.csv", row.names = FALSE)


