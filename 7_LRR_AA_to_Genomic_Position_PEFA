tx_id <- "XM_005243141.3"

map_aa_to_genome <- function(txdb, tx_id, aa_ranges_df) {
  library(GenomicFeatures)
  library(GenomicRanges)
  
  cds_by_tx <- cdsBy(txdb, by = "tx", use.names = TRUE)
  cds_ranges <- cds_by_tx[[tx_id]]
  
  if (is.null(cds_ranges)) {
    stop(paste("Transcript ID", tx_id, "not found in TxDb."))
  }
  
  nt_starts <- (aa_ranges_df$start - 1) * 3 + 1
  nt_ends <- aa_ranges_df$end * 3
  nt_ranges <- IRanges(start = nt_starts, end = nt_ends)
  
  # Recycle the CDS ranges across all input ranges
  cds_list <- rep(GRangesList(cds_ranges), length(nt_ranges))
  
  genomic_ranges <- pmapFromTranscripts(nt_ranges, cds_list)
  
  return(genomic_ranges)
}


