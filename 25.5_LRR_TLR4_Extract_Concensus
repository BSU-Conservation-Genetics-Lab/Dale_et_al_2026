#!/bin/bash
# Extract the LRR region from TLR4 whole genome haplotype 

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Hu-Liu_GYRF/Haplotype_072426/LRR/2_Phased_VCF_Genomes 

for genome in *_TLR4_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR4 from $sample"

    {
        echo ">${sample}_TLR4"

        samtools faidx "$genome" \
            NC_051195.1:42607201-42607212 \
            NC_051195.1:42607115-42607140 \
            NC_051195.1:42605802-42605841 \
            NC_051195.1:42605658-42605723 \
            NC_051195.1:42605586-42605651 \
            NC_051195.1:42605505-42605576 \
            NC_051195.1:42605427-42605489 \
            NC_051195.1:42604902-42604967 \
            NC_051195.1:42604824-42604889 \
            NC_051195.1:42604533-42604598 \
            NC_051195.1:42604461-42604526 \
            NC_051195.1:42604389-42604454 \
            NC_051195.1:42604311-42604379 \
        | awk '!/^>/'

    } | seqtk seq -r - > "${sample}_LRR.fa"

done
