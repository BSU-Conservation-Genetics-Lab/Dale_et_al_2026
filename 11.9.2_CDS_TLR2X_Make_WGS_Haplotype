#!/bin/bash
# Make whole genome haplotype sequence where TLR2X phased variants are applied 
# CDS

module load bcftools/1.14

export PATH=~/miniforge3/bin:$PATH

REF="/bsuhome/sagedale/scratch/Peregrine/Ref_Genome/PacBio_8_Feb25-fail/GCF_023634155.1_bFalPer1.pri_genomic_SEQUENTIAL.fna"

VCFDIR="/bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Global_PEFA/DNAsp_AllPEFA_81/CDS/2_Phased_VCF_Genomes"

cd "$VCFDIR"

GENE="TLR2X"

for sample in $(bcftools query -l PEFA-81_Bi_${GENE}_CDS.phased.vcf.gz); do

    echo "Processing $sample"

    bcftools consensus \
        -f "$REF" \
        -s "$sample" \
        -H 1pIu \
        PEFA-81_Bi_${GENE}_CDS.phased.vcf.gz \
        > "${sample}_${GENE}_hap1_genome.fa"

    bcftools consensus \
        -f "$REF" \
        -s "$sample" \
        -H 2pIu \
        PEFA-81_Bi_${GENE}_CDS.phased.vcf.gz \
        > "${sample}_${GENE}_hap2_genome.fa"

done
