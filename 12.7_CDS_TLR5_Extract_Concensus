#!/bin/bash
# Extract the CDS region from TLR5 from whole genome haplotype 

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Cali_Per_Hart_PEFA/DNAsp_CPH_28/CDS/2_Phased_VCF_Genomes

for genome in *_TLR5_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR5 from $sample"

    {
        echo ">${sample}_TLR5"

        samtools faidx "$genome" \
           NC_073731.1:26659171-26661756 \
        | awk '!/^>/'

   } | seqtk seq -r - > "${sample}_CDS.fa"

done
