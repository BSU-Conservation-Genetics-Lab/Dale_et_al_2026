#!/bin/bash
# Extract the CDS region from TLR1A from whole genome haplotype 
# Positive Strand

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Cali_Per_Hart_PEFA/DNAsp_CPH_28/CDS/2_Phased_VCF_Genomes

for genome in *_TLR1A_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR1A from $sample"

    {
        echo ">${sample}_TLR1A"

        samtools faidx "$genome" \
            NC_073722.1:27233553-27235955 \
        | awk '!/^>/'

   } > "${sample}_CDS.fa"

done
