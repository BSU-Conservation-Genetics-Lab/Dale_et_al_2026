#!/bin/bash
# Extract the LRR region from TLR1B whole genome haplotype 

export PATH=~/miniforge3/bin:$PATH

cd /bsuhome/sagedale/scratch/Manuscript_Prep/Var_Only/Cali_Per_Hart_PEFA/DNAsp_CPH_28/LRR/2_Phased_VCF_Genomes

for genome in *_TLR1B_hap*_genome.fa; do

    sample=$(basename "$genome" _genome.fa)

    echo "Extracting TLR1B from $sample"

    {
        echo ">${sample}_TLR1B"

        samtools faidx "$genome" \
            NC_073722.1:27223863-27223928 \
            NC_073722.1:27223941-27224006 \
            NC_073722.1:27224016-27224078 \
            NC_073722.1:27224082-27224150 \
            NC_073722.1:27224151-27224216 \
        | awk '!/^>/'

   } > "${sample}_LRR.fa"

done
